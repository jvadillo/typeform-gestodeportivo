HOST=127.0.0.1
PORT=8000
APP_URL=http://localhost:8000
DATA_DIR=./data
# Local: leave empty and set your password on first visit.
# Production: set at least 12 characters before starting.
ADMIN_PASSWORD=
APP_ENV=development
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Local: generated automatically in data/secret.key. Production: required.
SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
